# BandFit — template variabili d'ambiente
# Copia questo file in .env e sostituisci i placeholder. Non committare mai .env.

# Supabase: Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://TUO-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=la-tua-anon-public-key

# URL a cui Supabase rimanda dopo il login Google (slash finale incluso).
# In locale: http://localhost:8081
EXPO_PUBLIC_AUTH_REDIRECT_URL=https://TUO-USER.github.io/BandFit/

# Base URL pubblica del bucket Supabase "gifs" (slash finale incluso)
EXPO_PUBLIC_CDN_BASE_URL=https://TUO-PROJECT-REF.supabase.co/storage/v1/object/public/gifs/
